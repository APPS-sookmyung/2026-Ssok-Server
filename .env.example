# docker compose 용 환경 변수. 복사해서 .env 로 만들고 값을 채운다. (.env 는 커밋하지 않는다)

# MySQL
DB_USERNAME=ssok
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# pgvector (AI 서버용)
PGVECTOR_DB=ssok_vector
PGVECTOR_USER=ssok
PGVECTOR_PASSWORD=

# Spring
# openssl rand -base64 64
JWT_SECRET=
# Spring과 AI 서버가 같은 값을 사용. openssl rand -hex 32
AI_CALLBACK_SECRET=
# AI 서버 주소 (compose 안에서 함께 띄우면 http://ai-server:8000)
AI_SERVER_URL=http://ai-server:8000
# AI 서버가 콜백을 보낼 이 서버의 주소 (운영: https://api.도메인)
SERVER_PUBLIC_URL=http://server:8080
# 웹 프론트 주소와 확장 프로그램 origin (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080
SWAGGER_ENABLED=false

# AI 서버 이미지 (docker compose --profile ai)
AI_SERVER_IMAGE=ssok-ai-server:latest
