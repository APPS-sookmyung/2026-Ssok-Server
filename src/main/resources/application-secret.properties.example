# 이 파일을 application-secret.properties로 복사한 뒤 값을 채우세요. (환경 변수로 지정해도 됩니다)
DB_PASSWORD=
# openssl rand -base64 64 로 생성
JWT_SECRET=
# AI 서버 콜백 검증용 시크릿 (AI 서버와 동일한 값). 로컬에서 비워두면 검증을 생략하지만 prod 프로필에서는 비어 있으면 서버가 시작되지 않음
AI_CALLBACK_SECRET=
# AI 서버가 콜백을 보낼 이 서버의 외부 주소 (예: https://api.ssok.example)
SERVER_PUBLIC_URL=
# 교차 출처 허용 origin (쉼표 구분). 예: https://ssok.app,chrome-extension://abcdefghijklmnop
CORS_ALLOWED_ORIGINS=
